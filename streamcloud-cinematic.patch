diff --git a/cinema/portal.css b/cinema/portal.css
new file mode 100644
index 0000000..cbf34b2
--- /dev/null
+++ b/cinema/portal.css
@@ -0,0 +1,53 @@
+/* MahiFlix "Channel Jump" portal + preloader counter. Loaded after cinema.css. */
+
+/* ---------- portal (hidden entirely unless cinema/portal.js booted) ---------- */
+.portal-wrap{display:none;position:relative;width:min(210px,21svh,52vw);margin:14px auto 0;text-align:left}
+.portal-on .portal-wrap{display:block}
+.portal-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px;font-size:13px;color:#c9c9ce;letter-spacing:.02em;opacity:0}
+.portal-heading strong{font-size:15px;margin-left:4px;color:#fff;font-weight:700}
+.portal-in .portal-heading{animation:portal-caption .85s var(--ease,cubic-bezier(.22,1,.36,1)) both}
+@keyframes portal-caption{from{opacity:0;filter:blur(7px);transform:translateY(22px)}to{opacity:1;filter:blur(0);transform:translateY(0)}}
+
+/* The real pixels live on #portal-canvas. This button is the hit target, sized by layout. */
+.portal{position:relative;display:block;width:100%;aspect-ratio:320/350;padding:0;border:0;border-radius:28%/26%;background:transparent;cursor:pointer;color:#fff;font:inherit}
+.portal:focus-visible{outline:2px solid #fff;outline-offset:8px}
+.portal-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:40;pointer-events:none;display:block}
+
+/* No 2D canvas? Show a plain styled card instead so the control still exists and works. */
+.no-portal-gl .portal{background:linear-gradient(140deg,#4a0d12,#0d0d0d);border:1px solid rgba(255,255,255,.2);display:grid;place-items:center}
+.no-portal-gl .portal:after{content:attr(data-label);font:400 clamp(28px,5vw,40px)/1 "Bebas Neue",Impact,sans-serif;letter-spacing:.04em}
+.no-portal-gl .portal-heading{opacity:1;animation:none}
+
+/* make room: with the portal in the hero, size type by viewport height too so it stays above the fold */
+.portal-on .hero{padding:84px 4% 36px}
+.portal-on .hero h1{font-size:clamp(48px,min(10.5vw,15svh),138px);margin-bottom:14px}
+.portal-on .hero p{max-width:640px;margin-bottom:6px}
+.portal-on .hero-in .ig-link{margin:0 auto 2px}
+.portal-on .cue{display:none}   /* the portal is the primary "go browse" affordance */
+
+/* while travelling, the hero text steps aside (the nav stays, like a title sequence) */
+.hero-in>*{transition:opacity .45s var(--ease,ease),filter .45s var(--ease,ease)}
+.portal-travel .hero-in>:not(.portal-wrap),.portal-travel .cue,.portal-travel .portal-heading{opacity:0!important;filter:blur(8px)}
+.portal-travel .mode-wrap{opacity:0;transition:opacity .3s ease}
+
+/* ---------- preloader counter (inside the existing .intro overlay) ---------- */
+.intro-count{position:absolute;left:50%;bottom:clamp(54px,8vh,84px);display:flex;align-items:flex-end;gap:4px;transform:translateX(-50%);line-height:1;color:#fff;font-family:Inter,system-ui,sans-serif;opacity:0;animation:count-in .6s ease .25s forwards;pointer-events:none}
+.intro-count span{font-size:clamp(44px,8vw,64px);font-weight:200;letter-spacing:-.02em;font-variant-numeric:tabular-nums;min-width:1.2em;text-align:right}
+.intro-count i{font-style:normal;font-size:20px;padding-bottom:6px;opacity:.8}
+.intro-count.is-leaving{animation:count-out .75s var(--ease,cubic-bezier(.22,1,.36,1)) both}
+@keyframes count-in{to{opacity:1}}
+@keyframes count-out{from{opacity:1}to{opacity:0;filter:blur(7px);transform:translate(-50%,-34px)}}
+
+/* the logo that glides from screen centre into the nav slot */
+.fly-logo{position:fixed;z-index:101;background:url(../m-logo-v2.svg) center/contain no-repeat;transform-origin:0 0;pointer-events:none;will-change:transform,opacity}
+
+@media(max-width:640px){
+  .portal-wrap{width:min(190px,22svh,56vw);margin-top:14px}
+  .portal-on .hero h1{font-size:clamp(46px,min(16vw,11svh),84px)}
+  .portal-heading{font-size:12px}.portal-heading strong{font-size:14px}
+}
+@media(prefers-reduced-motion:reduce){
+  .portal-in .portal-heading{animation:none;opacity:1}
+  .hero-in>*{transition:none}
+  .intro-count{animation:none;opacity:1}
+}
diff --git a/cinema/portal.js b/cinema/portal.js
new file mode 100644
index 0000000..e235864
--- /dev/null
+++ b/cinema/portal.js
@@ -0,0 +1,277 @@
+// "Channel Jump": a tilting canvas window in the hero shows a live reel of the OTHER collection.
+// Activating it expands the window to fill the screen, switches Websites <-> Apps through the
+// page's own mode buttons, then irises open onto the catalog.
+//
+// Technique adapted from the Planet Jumping reference: a screen-locked media layer seen through a
+// clipped, fake-perspective rounded rectangle. Here the "media" is generated from the catalog
+// itself (local logo marks, initials tiles), so there is no remote video to fail or wait for.
+import { state, clamp } from './state.js';
+
+const root = document.documentElement;
+const ease = t => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);   // easeInOutCubic
+const lerp = (a, b, t) => a + (b - a) * t;
+const LABEL = { sites: 'Websites', apps: 'Apps' };
+const FOCAL = 850;
+
+export function initPortal() {
+  const btn = document.getElementById('portal');
+  const canvas = document.getElementById('portal-canvas');
+  const wrap = document.querySelector('.portal-wrap');
+  const nameEl = document.getElementById('portalName');
+  const countEl = document.getElementById('portalCount');
+  if (!btn || !canvas || !wrap) return;
+
+  const modeNow = () => (document.querySelector('.mode.active') || {}).dataset?.mode || 'sites';
+  const otherMode = () => (modeNow() === 'sites' ? 'apps' : 'sites');
+  const catalog = m => (window.MAHIFLIX_CATALOG && window.MAHIFLIX_CATALOG[m]) || [];
+
+  root.classList.add('portal-on');
+  const ctx = canvas.getContext('2d');
+  let canvasOk = !!ctx;
+  if (!canvasOk) root.classList.add('no-portal-gl');
+
+  // ---------------------------------------------------------------- state
+  let iw = innerWidth, ih = innerHeight;
+  let rotX = 0, rotY = 0, tX = 0, tY = 0, hover = 0, hovering = false;
+  let expansion = 0, iris = 0, maskScale = 0, busy = false, lockReel = false;
+  let visible = false, raf = 0, last = 0;
+  let reelMode = otherMode(), tiles = [], tileSize = 96;
+  const imgs = new Map();
+
+  // ---------------------------------------------------------------- reel content
+  const hue = n => { let h = 0; for (let i = 0; i < n.length; i++) h = (h * 31 + n.charCodeAt(i)) % 360; return h; };
+  const initials = n => n.replace(/[^a-z0-9 ]/gi, '').split(/\s+/).map(x => x[0] || '').join('').slice(0, 2).toUpperCase();
+  function imageFor(src) {
+    if (!src) return null;
+    if (!imgs.has(src)) {
+      const im = new Image(); im.decoding = 'async';
+      im.onload = () => kick();
+      im.src = src; imgs.set(src, im);
+    }
+    return imgs.get(src);
+  }
+  function buildReel(mode) {
+    reelMode = mode;
+    const items = catalog(mode);
+    tiles = (items.length ? items : [{ name: 'MahiFlix', domain: '' }]).map(it => ({
+      name: it.name, h: hue(it.name), ini: initials(it.name),
+      img: imageFor((window.MAHIFLIX_LOGOS || {})[it.domain]),
+    }));
+    kick();
+  }
+  function syncLabels() {
+    const next = otherMode(), n = catalog(next).length;
+    if (nameEl) nameEl.textContent = LABEL[next];
+    if (countEl) countEl.textContent = '[' + String(n).padStart(2, '0') + ']';
+    btn.setAttribute('aria-label', 'Jump to ' + LABEL[next]);
+    btn.dataset.label = LABEL[next];
+    if (!lockReel && reelMode !== next) buildReel(next);
+  }
+
+  // ---------------------------------------------------------------- canvas plumbing
+  function resize() {
+    iw = innerWidth; ih = innerHeight;
+    if (!canvasOk) return;
+    const d = Math.min(devicePixelRatio || 1, 2);
+    canvas.width = Math.round(iw * d); canvas.height = Math.round(ih * d);
+    canvas.style.width = iw + 'px'; canvas.style.height = ih + 'px';
+    ctx.setTransform(d, 0, 0, d, 0, 0);
+    kick();
+  }
+  function sizeTiles() {
+    const w = btn.getBoundingClientRect().width || 200;
+    tileSize = clamp(w * .46, 64, 150);
+  }
+
+  // ---------------------------------------------------------------- reel drawing
+  function drawTile(t, x, y, s) {
+    const r = s * .2;
+    if (t.img && t.img.complete && t.img.naturalWidth) {
+      ctx.drawImage(t.img, x, y, s, s);
+      return;
+    }
+    const g = ctx.createLinearGradient(x, y, x + s, y + s);
+    g.addColorStop(0, `hsl(${t.h} 55% 34%)`); g.addColorStop(1, '#0d0d0d');
+    ctx.fillStyle = g;
+    ctx.beginPath();
+    ctx.roundRect ? ctx.roundRect(x, y, s, s, r) : ctx.rect(x, y, s, s);
+    ctx.fill();
+    ctx.fillStyle = 'rgba(255,255,255,.92)';
+    ctx.font = `400 ${s * .42}px "Bebas Neue", Impact, sans-serif`;
+    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
+    ctx.fillText(t.ini, x + s / 2, y + s / 2 + s * .03);
+  }
+  // `box` = screen-space bounds worth painting (cull everything else)
+  function drawReel(time, zoom, box) {
+    const s = tileSize, gap = Math.max(8, s * .1), pitch = s + gap;
+    const cols = Math.ceil(iw / pitch) + 2, rows = Math.ceil(ih / pitch) + 3, span = rows * pitch;
+    const cx = iw / 2, cy = ih / 2, n = tiles.length, still = state.reduced;
+    const x0 = (iw - (cols - 2) * pitch) / 2;
+    for (let c = 0; c < cols; c++) {
+      const speed = still ? 0 : (c % 2 ? 1 : -1) * (12 + (c * 7) % 19);
+      const off = c * pitch * 1.7 + time / 1000 * speed;
+      const x = x0 + (c - 1) * pitch, sx = cx + (x - cx) * zoom;
+      if (sx + s * zoom < box.l || sx > box.r) continue;
+      for (let r = 0; r < rows; r++) {
+        const y = ((((r * pitch + off) % span) + span) % span) - pitch, sy = cy + (y - cy) * zoom;
+        if (sy + s * zoom < box.t || sy > box.b) continue;
+        drawTile(tiles[(c * 3 + r) % n], x, y, s);
+      }
+    }
+  }
+  function drawShade() {
+    const g = ctx.createLinearGradient(0, ih * .52, 0, ih);
+    g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,0,.88)');
+    ctx.fillStyle = g; ctx.fillRect(0, ih * .52, iw, ih * .48);
+  }
+
+  // ---------------------------------------------------------------- fake-3D rounded rectangle
+  function outline(w, h, r) {
+    r = Math.min(r, w / 2, h / 2);
+    const pts = [], arcs = [
+      [w / 2 - r, -h / 2 + r, -Math.PI / 2, 0], [w / 2 - r, h / 2 - r, 0, Math.PI / 2],
+      [-w / 2 + r, h / 2 - r, Math.PI / 2, Math.PI], [-w / 2 + r, -h / 2 + r, Math.PI, Math.PI * 1.5]];
+    for (const [ax, ay, a0, a1] of arcs)
+      for (let i = 0; i <= 10; i++) { const a = a0 + (a1 - a0) * i / 10; pts.push([ax + Math.cos(a) * r, ay + Math.sin(a) * r]); }
+    return pts;
+  }
+  function project(pts, cx, cy, rx, ry) {
+    const ax = rx * Math.PI / 180, ay = ry * Math.PI / 180, ca = Math.cos(ay), cb = Math.cos(ax), sa = Math.sin(ay), sb = Math.sin(ax);
+    return pts.map(([x, y]) => {
+      const xx = x * ca, yy = y * cb, z = x * sa - y * sb, p = FOCAL / (FOCAL + z);
+      return [cx + xx * p, cy + yy * p];
+    });
+  }
+
+  function draw(now) {
+    ctx.clearRect(0, 0, iw, ih);
+    if (maskScale <= 0 && !expansion && !iris) return;
+    const rect = btn.getBoundingClientRect();
+    if (!busy && (rect.bottom < 0 || rect.top > ih)) return;
+    const rcx = rect.left + rect.width / 2, rcy = rect.top + rect.height / 2;
+    let e = expansion, scale = e ? 1 : maskScale * (1 + hover * .04);
+    if (iris > 0) { e = 1; scale = 1 - iris; }
+    const cx = lerp(rcx, iw / 2, e), cy = lerp(rcy, ih / 2, e);
